{
  "name": "breaker40-cb",
  "productName": "Breaker 40 CB",
  "version": "1.0.8",
  "description": "A 40-channel CB radio for your desktop. Push to talk with anyone else running the app.",
  "main": "main.js",
  "author": "devliquid <78886688+devliquid@users.noreply.github.com>",
  "homepage": "https://github.com/devliquid/cb-radio",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "test": "node test/relay-test.js",
    "test:exe": "node test/basestation-exe-test.js",
    "dist": "electron-builder --win portable nsis",
    "dist:linux": "electron-builder --linux AppImage deb -c.productName=Breaker40CB",
    "dist:relay": "node build/build-relay.js",
    "dist:all": "npm run dist && npm run dist:relay"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.breaker40.cb",
    "productName": "Breaker 40 CB",
    "afterPack": "build/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "server/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "breaker40-cb",
      "category": "Network",
      "synopsis": "40-channel push-to-talk CB radio",
      "desktop": {
        "Name": "Breaker 40 CB",
        "Comment": "40-channel push-to-talk CB radio"
      },
      "artifactName": "Breaker40-CB-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "build/deb-after-install.sh",
      "artifactName": "breaker40-cb_${version}_${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Breaker40-CB-Portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "Breaker40-CB-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
